rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Rides Collection: Public student carpool directory
    match /rides/{rideId} {
      allow read: if true;
      allow create: if request.resource.data.driverId is string &&
                       request.resource.data.originArea is string &&
                       request.resource.data.destinationCampus in ['Beirut', 'Byblos'] &&
                       request.resource.data.totalSeats >= 1 &&
                       request.resource.data.availableSeats >= 0 &&
                       request.resource.data.status in ['active', 'completed', 'cancelled'];
      allow update: if request.resource.data.availableSeats >= 0 &&
                       request.resource.data.status in ['active', 'completed', 'cancelled'];
      allow delete: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.resource.data.name is string &&
                      request.resource.data.campus in ['Beirut', 'Byblos'];
    }

    // Connection test doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
